  "sourceCode": "void heapSort(int array[], int count) {\n  buildMinHeap(array, count);\n\n  for (int heapSize = count; heapSize > 1; heapSize--) {\n    swap(&array[0], &array[heapSize - 1]);\n    siftDown(array, 0, heapSize - 1);\n  }\n}\n\nvoid buildMinHeap(int array[], int count) {\n  for (int i = count / 2 - 1; i >= 0; i--) {\n    siftDown(array, i, count);\n  }\n}\n\nvoid siftDown(int array[], int root, int heapSize) {\n  int child = smallerChild(array, root, heapSize);\n  while (child != -1 && array[root] > array[child]) {\n    swap(&array[root], &array[child]);\n    root = child;\n    child = smallerChild(array, root, heapSize);\n  }\n}",
